<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- 太空灰 -->
    <material name="body_grey">
        <color rgba="0.45 0.48 0.52 1.0"/>
    </material>

    <!-- 巧克力色 -->
    <material name="chocolate">
        <color rgba="0.5 0.25 0.0 1.0"/>
    </material>

    <!-- 深海蓝 -->
    <material name="deep_blue">
        <color rgba="0.1 0.2 0.45 1.0"/>
    </material>

    <!-- 活力橙 -->
    <material name="vibrant_orange">
        <color rgba="1.0 0.5 0.0 1.0"/>
    </material>

    <!-- 亮银白 -->
    <material name="silver_white">
        <color rgba="0.85 0.88 0.9 1.0"/>
    </material>

    <!-- 连杆1：亮浅银 -->
    <material name="link_bright_silver">
        <color rgba="0.86 0.89 0.92 1.0"/>
    </material>

    <!-- 连杆2：炭灰色 -->
    <material name="link_charcoal">
        <color rgba="0.26 0.29 0.32 1.0"/>
    </material>

    <!-- 连杆3 冷调金属蓝 -->
    <material name="link_cold_blue_metal">
        <color rgba="0.20 0.33 0.48 1.0"/>
    </material>

    <xacro:macro name="box_inertia" params="m x y z o_xyz o_rpy">
        <inertial>
            <mass value="${m}"/>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
            <inertia ixx="${(m/12) * (y*y + z*z)}" ixy="0.0" ixz="0.0"
                     iyy="${(m/12) * (x*x + z*z)}" iyz="0.0"
                     izz="${(m/12) * (x*x + y*y)}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r l o_xyz o_rpy">
        <inertial>
            <mass value="${m}"/>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
            <inertia ixx="${(m/12) * (3*r*r + l*l)}" ixy="0.0" ixz="0.0"
                     iyy="${(m/12) * (3*r*r + l*l)}" iyz="0.0"
                     izz="${(m/2) * (r*r)}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="sphere_inertia" params="m r o_xyz o_rpy">
        <inertial>
            <mass value="${m}"/>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
            <inertia ixx="${2*m*r*r/5}" ixy="0.0" ixz="0.0"
                     iyy="${2*m*r*r/5}" iyz="0.0"
                     izz="${2*m*r*r/5}"/>
        </inertial>
    </xacro:macro>


</robot>